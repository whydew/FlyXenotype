<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Flies appear in faction pawns (raids, visitors, traders, quest pawns) at the same 2.5% as minor
       vanilla xenotypes. Factionless pawns (wanderers, refugees, many quest joiners) already roll Flies via
       XenotypeDef.factionlessGenerationWeight, which defaults to 1 (Baseliner is 40). -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Biotech</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/xenotypeSet/xenotypeChances</xpath>
          <value><FB_Fly>0.025</FB_Fly></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/FactionDef[@Name="PirateBandBase"]/xenotypeSet/xenotypeChances</xpath>
          <value><FB_Fly>0.025</FB_Fly></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
