<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>FB_AteSweet</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>sugar rush</label>
        <description>Something sweet. Everything is fine now.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>FB_Swarm</defName>
    <workerClass>FlyXenotype.ThoughtWorker_FlySwarm</workerClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>no swarm</label>
        <description>There is nobody like me here. It is too quiet.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>in company</label>
        <description>Others of my kind are close by.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <li>
        <label>swarming</label>
        <description>Surrounded by my swarm. Everything hums.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
